			public function addComponent(bodyCmpnt:CCBodyComponentModel, ccChar:CCBodyModel, properties:Object) : void
			{
				var bodyShape:CCBodyShapeModel = this.theme.bodyShapes[ccChar.bodyShapeId];
				var component:CCComponentModel = bodyShape.getComponent(bodyCmpnt.type, bodyCmpnt.id);
				var actionId:String = theme.getCharacterDefaultActionId(ccChar.bodyShapeId);
				var state:String = this.theme.getActions(bodyShape.bodyShapeId)[actionId].componentStates[bodyCmpnt.type];
				this.cam.addComponent(
					bodyCmpnt,
					component.getFilenameByState(state),
					this.theme.themeId + "/" + component.getPathByState(state)
				);
				CustomCharacterMaker(this.myUI.getChildByName(this.LOADER)).myActionModel = this.cam;

				var colors:Array = new Array();
				var num:Number = ccChar.colors.length;
				var i:int = 0;
				while (i < num)
				{
					var color:CCColor = ccChar.colors[i];
					if(color.targetComponent == bodyCmpnt.type || color.type == "ccSkinColor" || color.type == "ccFaceHairColor")
					{
						var colorObj:Object = new Object();
						colorObj["colorReference"] = color.type;
						colorObj["originalColor"] = color.oc ? color.oc : uint.MAX_VALUE;
						colorObj["colorValue"] = color.dest;
						colorObj["targetComponentId"] = color.targetComponent == null ? "" : color.targetComponent;
						colors.push(colorObj);
					}
					i++;
				}



var path:String = this.cam.getComponentByType(bodyCmpnt.type).path;
var storeUrl:String = CcActionLoader.getStoreUrl(this.cam.getComponentByType(bodyCmpnt.type).path);

				var compLoader:CcComponentLoader = CcComponentLoader.getComponentLoader(path, storeUrl);
				var self:CharPreviewer = this;
				compLoader.addEventListener(Event.COMPLETE, function onloaded(e:Event) : void
				{
					var loader:CcComponentLoader = CcComponentLoader(e.target);
					if (loader)
					{
						loader.removeEventListener(e.type, onloaded);
						var loadMgr:UtilLoadMgr = new UtilLoadMgr();
						CustomCharacterMaker(self.myUI.getChildByName(self.LOADER))
							.updateComponentImageData(bodyCmpnt.type, loader.swfBytes, properties, loadMgr, colors, path)
							.addEventListener(Event.INIT, self.updateComponented);
						loadMgr.commit();
					}
				});
				compLoader.addEventListener(IOErrorEvent.IO_ERROR, this.onCcComponentFailed);
				compLoader.load();
				
			}
