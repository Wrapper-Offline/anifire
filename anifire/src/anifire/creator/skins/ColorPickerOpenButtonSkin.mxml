<?xml version="1.0" encoding="utf-8"?>
<s:SparkButtonSkin
	xmlns:fx="http://ns.adobe.com/mxml/2009" 
	xmlns:s="library://ns.adobe.com/flex/spark" 
	xmlns:mx="library://ns.adobe.com/flex/mx"
	minWidth="60"
	minHeight="32"
	alpha.disabled="0.5">

	<s:states>
		<s:State name="up"/>
		<s:State name="over" stateGroups="overAndDownStates"/>
		<s:State name="down" stateGroups="overAndDownStates"/>
		<s:State name="disabled"/>
	</s:states>

	<!-- <s:Ellipse height="25" width="25">
		<s:stroke>
			<s:SolidColorStroke color="0xBBBBBB"/>
		</s:stroke>
		<s:fill>
			<s:SolidColor color="0xBBBBBB"/>
		</s:fill>
	</s:Ellipse> -->
	<s:Rect
		width="60"
		height="32"
		topLeftRadiusX="15"
		topLeftRadiusY="15"
		topRightRadiusX="0"
		topRightRadiusY="0"
		bottomLeftRadiusX="15"
		bottomLeftRadiusY="15"
		bottomRightRadiusX="0"
		bottomRightRadiusY="0">
		<s:fill>
			<s:SolidColor color="0xFFFFFF"/>
		</s:fill>
	</s:Rect>
	<s:Rect
		width="58"
		height="28"
		top="2"
		left="2"
		topLeftRadiusX="15"
		topLeftRadiusY="15"
		topRightRadiusX="3"
		topRightRadiusY="3"
		bottomLeftRadiusX="15"
		bottomLeftRadiusY="15"
		bottomRightRadiusX="3"
		bottomRightRadiusY="3">
		<s:fill>
			<s:SolidColor color="0xDDDDDD" color.overAndDownStates="0xFC4F7D"/>
		</s:fill>
	</s:Rect>

</s:SparkButtonSkin>
