<?xml version="1.0" encoding="utf-8"?>
<s:Group
	xmlns:fx="http://ns.adobe.com/mxml/2009" 
	xmlns:s="library://ns.adobe.com/flex/spark" 
	xmlns:mx="library://ns.adobe.com/flex/mx"
	xmlns:components="anifire.creator.components.*"
	width="65"
	height="65">

	<fx:Script>
		<![CDATA[
			import flash.events.MouseEvent;
			import anifire.creator.events.PositionInspectorEvent;

			private function onMouseDown(e:Event) : void
			{
				var event:PositionInspectorEvent = new PositionInspectorEvent(PositionInspectorEvent.DPAD_MOUSE_DOWN, this);
				event.dpad_action = getTypeByEventTarget(e.currentTarget);
				dispatchEvent(event);
			}
			
			private function onMouseUp(e:Event) : void
			{
				var event:PositionInspectorEvent = new PositionInspectorEvent(PositionInspectorEvent.DPAD_MOUSE_UP, this);
				dispatchEvent(event);
			}

			private function getTypeByEventTarget(obj:Object) : String
			{
				var actionType:String = "";
				switch (obj) {
					case btnUp:
						actionType = PositionInspectorEvent.UP_BUTTON_CLICK;
						break;
					case btnDown:
						actionType = PositionInspectorEvent.DOWN_BUTTON_CLICK;
						break;
					case btnLeft:
						actionType = PositionInspectorEvent.LEFT_BUTTON_CLICK;
						break;
					case btnRight:
						actionType = PositionInspectorEvent.RIGHT_BUTTON_CLICK;
				}
				return actionType;
			}
		]]>
	</fx:Script>

	<s:Image source="@Embed('../images/positionInspector/directionPad.png')"/>
	<components:IconButton
		id="btnUp"
		buttonMode="true"
		enabled="true"
		horizontalCenter="0"
		top="0"
		icon="@Embed('../images/positionInspector/arrowUp.png')"
		iconOver="@Embed('../images/positionInspector/arrowUp_hover.png')"
		iconDown="@Embed('../images/positionInspector/arrowUp_down.png')"
		mouseDown="onMouseDown(event)"
		mouseOut="onMouseUp(event)"
		mouseUp="onMouseUp(event)"/>
	<components:IconButton
		id="btnDown"
		buttonMode="true"
		enabled="true"
		horizontalCenter="0"
		bottom="0"
		icon="@Embed('../images/positionInspector/arrowDown.png')"
		iconOver="@Embed('../images/positionInspector/arrowDown_hover.png')"
		iconDown="@Embed('../images/positionInspector/arrowDown_down.png')"
		mouseDown="onMouseDown(event)"
		mouseOut="onMouseUp(event)"
		mouseUp="onMouseUp(event)"/>
	<components:IconButton
		id="btnLeft"
		buttonMode="true"
		enabled="true"
		verticalCenter="0"
		left="0"
		icon="@Embed('../images/positionInspector/arrowLeft.png')"
		iconOver="@Embed('../images/positionInspector/arrowLeft_hover.png')"
		iconDown="@Embed('../images/positionInspector/arrowLeft_down.png')"
		mouseDown="onMouseDown(event)"
		mouseOut="onMouseUp(event)"
		mouseUp="onMouseUp(event)"/>
	<components:IconButton
		id="btnRight"
		buttonMode="true"
		enabled="true"
		verticalCenter="0"
		right="0"
		icon="@Embed('../images/positionInspector/arrowRight.png')"
		iconOver="@Embed('../images/positionInspector/arrowRight_hover.png')"
		iconDown="@Embed('../images/positionInspector/arrowRight_down.png')"
		mouseDown="onMouseDown(event)"
		mouseOut="onMouseUp(event)"
		mouseUp="onMouseUp(event)"/>

</s:Group>
